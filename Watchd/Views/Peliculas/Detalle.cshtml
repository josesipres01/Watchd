@model Watchd.Models.Pelicula

@{
    ViewData["Title"] = Model.Titulo;
}

<div class="mb-4">
    <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
        &larr; Volver al Catálogo
    </a>
</div>

<div class="card shadow border-0 overflow-hidden">
    <div class="row g-0">
        <div class="col-md-4 text-center bg-dark d-flex align-items-center justify-content-center" style="min-height: 420px;">
            @if (!string.IsNullOrWhiteSpace(Model.Poster))
            {
                <img src="@Model.Poster" 
                     class="img-fluid rounded-start w-100 h-100" 
                     alt="Poster de @Model.Titulo" 
                     style="object-fit: cover; max-height: 520px;"
                     onerror="this.onerror=null; this.src='https://placehold.co/400x600?text=Sin+Poster';" />
            }
            else
            {
                <div class="text-white p-4">
                    <span class="display-3">🎬</span>
                    <p class="mt-2 text-light">Sin póster disponible</p>
                </div>
            }
        </div>
        <div class="col-md-8">
            <div class="card-body p-4 p-md-5 d-flex flex-column h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <h1 class="card-title h2 fw-bold mb-0">@Model.Titulo</h1>
                    @if (Model.AnoLanzamiento.HasValue)
                    {
                        <span class="badge bg-secondary fs-6">@Model.AnoLanzamiento</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Director))
                {
                    <h5 class="text-muted fw-normal mb-3">Dirigida por <strong>@Model.Director</strong></h5>
                }

                <div class="d-flex flex-wrap gap-3 align-items-center mb-4">
                    @if (Model.CalificacionPromedio.HasValue)
                    {
                        <div class="d-flex align-items-center bg-warning bg-opacity-25 text-warning-emphasis px-3 py-1 rounded">
                            <span class="fs-5 me-1 text-warning">★</span>
                            <span class="fw-bold fs-5">@Model.CalificacionPromedio.Value.ToString("0.0")</span>
                            <span class="text-muted small ms-1">/ 10</span>
                        </div>
                    }

                    @if (Model.TotalReviews.HasValue)
                    {
                        <span class="text-muted small">
                            <strong>@Model.TotalReviews</strong> reseñas registradas
                        </span>
                    }

                    @if (Model.Duracion.HasValue)
                    {
                        <span class="badge bg-light text-dark border">
                            ⏱ @Model.Duracion minutos
                        </span>
                    }

                    @if (Model.TmdbId.HasValue)
                    {
                        <span class="badge bg-info bg-opacity-25 text-info-emphasis">
                            TMDB ID: @Model.TmdbId
                        </span>
                    }
                </div>

                <div class="mb-4">
                    <h5 class="fw-semibold">Sinopsis</h5>
                    <p class="lead fs-6 text-secondary">
                        @(string.IsNullOrWhiteSpace(Model.Sinopsis) ? "No se ha agregado una sinopsis para esta película." : Model.Sinopsis)
                    </p>
                </div>

                <div class="mt-auto pt-3 border-top d-flex gap-2">
                    <a asp-controller="Resenas" asp-action="Crear" class="btn btn-primary">
                        ✍ Escribir Reseña
                    </a>
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        Ver más películas
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

