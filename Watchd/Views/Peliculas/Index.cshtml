@model IEnumerable<Watchd.Models.Pelicula>

@{
    ViewData["Title"] = "Catálogo de Películas";
    var buscar = ViewBag.Buscar as string;
    var ordenarPor = ViewBag.OrdenarPor as string;
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h2 mb-1">Catálogo de Películas</h1>
        <p class="text-muted mb-0">Explora la colección de películas registradas en Watchd</p>
    </div>
    <a asp-action="AgregarPelicula" class="btn btn-primary">
        + Agregar Película
    </a>
</div>

@if (TempData["Exito"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["Exito"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Barra de búsqueda y filtros -->
<form method="get" asp-action="Index" class="card shadow-sm mb-4 border-0 bg-light">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-md-6">
                <input type="text" 
                       name="buscar" 
                       value="@buscar" 
                       class="form-control" 
                       placeholder="Buscar por título o director..." />
            </div>
            <div class="col-md-4">
                <select name="ordenarPor" class="form-select">
                    <option value="" selected="@(string.IsNullOrEmpty(ordenarPor))">Ordenar por: Más recientes agregadas</option>
                    <option value="recientes" selected="@(ordenarPor == "recientes")">Año de estreno (más reciente)</option>
                    <option value="antiguos" selected="@(ordenarPor == "antiguos")">Año de estreno (más antiguo)</option>
                    <option value="calificacion" selected="@(ordenarPor == "calificacion")">Mayor calificación</option>
                    <option value="titulo" selected="@(ordenarPor == "titulo")">Título (A-Z)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-dark w-100">Buscar</button>
                @if (!string.IsNullOrWhiteSpace(buscar) || !string.IsNullOrWhiteSpace(ordenarPor))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">✕</a>
                }
            </div>
        </div>
    </div>
</form>

<!-- Listado en Cards -->
@if (Model != null && Model.Any())
{
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var pelicula in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0 position-relative">
                    @if (!string.IsNullOrWhiteSpace(pelicula.Poster))
                    {
                        <img src="@pelicula.Poster" 
                             class="card-img-top" 
                             alt="Poster de @pelicula.Titulo" 
                             style="height: 340px; object-fit: cover;" 
                             onerror="this.onerror=null; this.src='https://placehold.co/300x450?text=Sin+Poster';" />
                    }
                    else
                    {
                        <div class="d-flex align-items-center justify-content-center bg-secondary text-white" 
                             style="height: 340px;">
                            <div class="text-center p-3">
                                <span class="display-6">🎬</span>
                                <p class="mt-2 mb-0 small text-light">Sin póster disponible</p>
                            </div>
                        </div>
                    }

                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-1">
                            <h5 class="card-title mb-0 fs-6 fw-bold">
                                <a asp-action="Detalle" asp-route-id="@pelicula.Id" class="text-decoration-none text-dark">
                                    @pelicula.Titulo
                                </a>
                            </h5>
                            @if (pelicula.AnoLanzamiento.HasValue)
                            {
                                <span class="badge bg-secondary">@pelicula.AnoLanzamiento</span>
                            }
                        </div>

                        @if (!string.IsNullOrWhiteSpace(pelicula.Director))
                        {
                            <p class="card-subtitle text-muted small mb-2">Dir: @pelicula.Director</p>
                        }

                        @if (!string.IsNullOrWhiteSpace(pelicula.Sinopsis))
                        {
                            <p class="card-text small text-secondary flex-grow-1" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                                @pelicula.Sinopsis
                            </p>
                        }
                        else
                        {
                            <p class="card-text small text-muted fst-italic flex-grow-1">Sin sinopsis.</p>
                        }

                        <div class="border-top pt-2 mt-auto d-flex justify-content-between align-items-center small">
                            <div>
                                @if (pelicula.CalificacionPromedio.HasValue)
                                {
                                    <span class="text-warning fw-bold">★ @pelicula.CalificacionPromedio.Value.ToString("0.0")</span>
                                    <span class="text-muted">/10</span>
                                }
                                else
                                {
                                    <span class="text-muted">Sin calificar</span>
                                }
                            </div>
                            @if (pelicula.Duracion.HasValue)
                            {
                                <span class="text-muted">@pelicula.Duracion min</span>
                            }
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-0 pt-0 pb-3">
                        <a asp-action="Detalle" asp-route-id="@pelicula.Id" class="btn btn-sm btn-outline-primary w-100">
                            Ver Detalles
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 card border-0 shadow-sm bg-light">
        <div class="card-body py-5">
            <span class="display-3 text-muted">🎬</span>
            <h3 class="mt-3">No se encontraron películas</h3>
            @if (!string.IsNullOrWhiteSpace(buscar))
            {
                <p class="text-muted">No hubo coincidencias para la búsqueda "<strong>@buscar</strong>".</p>
                <a asp-action="Index" class="btn btn-outline-secondary me-2">Ver todo el catálogo</a>
            }
            else
            {
                <p class="text-muted">Aún no se han agregado películas al catálogo.</p>
                <a asp-action="AgregarPelicula" class="btn btn-primary">Agregar la primera película</a>
            }
        </div>
    </div>
}

